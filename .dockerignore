# Keep the build context small and free of secrets. Anything listed here never
# reaches the daemon, so it cannot end up in a layer even by accident.

.env
.env.*
!.env.example
users.json
users.json.tmp
*.pem
*.key

.venv/
venv/
ENV/
env/

exports/
temp/
tmp/
scratch/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/

*.log
*.pid
*.exe
nvenc_probe.mp4
test_audio.wav

.git/
.github/
.gitignore
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Generated media at the project root; assets/ is deliberately kept.
/*.mp4
/*.webm
/*.mov
/*.mkv
/*.mp3
/*.wav
