# ReelForge Studio -- copy to .env and fill in. .env is gitignored.

# ---- AI ---------------------------------------------------------------
# Gemini: scripts, video grounding, scene specs and licensed TTS.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels: CC0 stock footage for the licensed library. Optional -- without it
# the app falls back to Wikimedia Commons, which needs no key.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- YouTube ----------------------------------------------------------
# Niche Scout's competitor recon. This is NOT the Gemini key: an AI Studio key
# returns 401 against the YouTube Data API. Create a Google Cloud project,
# enable "YouTube Data API v3", then create an API key.
#
# Optional. Without it every other part of Niche Scout still works; only the
# saturation score goes unmeasured, and it says so rather than guessing.
#
# Quota: search.list costs 100 units of the default 10,000/day, so roughly 90
# recons a day. It resets at midnight Pacific.
YOUTUBE_API_KEY=

# ---- Accounts ---------------------------------------------------------
# Optional. Without these the app creates an admin on first run and prints the
# password to the server console.
#
# Prefer the *_HASH form; a plaintext password in the environment is visible in
# `docker inspect` and in the process list. Generate a hash with:
#   python -c "import auth; print(auth.hash_password('your-password'))"
REELFORGE_ADMIN_USER=admin
REELFORGE_ADMIN_PASSWORD_HASH=

# Extra accounts as JSON, for deployments with no writable users.json:
# REELFORGE_USERS={"ana":{"password_hash":"pbkdf2_sha256$...","role":"creator"}}
REELFORGE_USERS=

# ---- Runtime ----------------------------------------------------------
# Point moviepy/imageio at the system ffmpeg. The Docker image sets this; on a
# desktop leave it blank and the bundled binary is used.
IMAGEIO_FFMPEG_EXE=
